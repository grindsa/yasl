# yasl backup schedule (2nd Friday each month at 07:40)
# Cron expression explanation:
#   minute=40 hour=7 day=8-14 month=* weekday=5 (Friday)
#
# Required setup:
# - Configure backup variables in /srv/stacks/yasl/.env
#   (for example: REMOTE_TARGET, REMOTE_DIR, SSH_KEY, LOCAL_KEEP, REMOTE_KEEP,
#    BACKUP_ROOT, TMP_ROOT)
# - WhatsApp notification uses WA_ADMIN_NUMBER, WA_SRV and WA_PORT from .env
#   (optional override variables: WA_NOTIFY_NUMBER, WA_NOTIFY_SRV, WA_NOTIFY_PORT)
# - WA send path uses host python binary defined via WA_PYTHON_BIN
#   (default: /home/joern/.venv/bin/python — same venv as proxy)

# Run backup
40 7 8-14 * 5 cd /srv/stacks/yasl && ./scripts/backup.yasl.sh >> /srv/stacks/yasl/logs/backup-yasl-cron.log 2>&1
