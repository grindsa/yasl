# Optional — set automatically by deploy.sh / Dockerfile (YYYY-MM-DD-HH-MM-SS)
# BUILD_TIME=

# Auth — signs the HttpOnly session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Change to any new value to log out every device (sessions last 14 days since last use).
# SESSION_EPOCH=1

# Group tokens live in config/groups.yml (not here). See config/groups.example.yml.

# Optional override for YAML shopping-list data (default: ./data or /app/data in Docker)
# DATA_DIR=/app/data

# Optional path to groups config (default: config/groups.yml)
# GROUPS_CONFIG_FILE=config/groups.yml
