# Optional — set automatically by deploy.sh / Dockerfile (YYYY-MM-DD-HH-MM-SS)
# BUILD_TIME=

# Auth — signs the HttpOnly session cookie. Generate with: openssl rand -hex 32
AUTH_SECRET=

# Change to any new value to log out every device (sessions last 14 days since last use).
# SESSION_EPOCH=1

# Group tokens live in config/groups.yml (not here). See config/groups.example.yml.

# Optional override for YAML shopping-list data (default: ./data or /app/data in Docker)
# DATA_DIR=/app/data

# Optional path to groups config (default: config/groups.yml)
# GROUPS_CONFIG_FILE=config/groups.yml

# Optional: supermarket aisle categorization (Laufweg). Off unless set.
# ENABLE_DEPARTMENTS=true

# Soft-delete grace period (seconds) after tapping an item before it is removed.
# During this window the item is struck through and a second tap cancels.
# ITEM_DELETE_DELAY_SECONDS=3

# Web Push (optional). Required when any group has notifications.enabled: true.
# Generate once: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

