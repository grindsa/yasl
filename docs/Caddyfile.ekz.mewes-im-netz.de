# Caddy site block for YASL
# Host: https://ekz.mewes-im-netz.de
# Upstream: container `yasl:3000` on external Docker network `proxy`
#
# Merge this into the Caddyfile of your reverse-proxy stack (the one that
# joins network `proxy`), then reload Caddy.
#
# CSP, X-Frame-Options, nosniff, Referrer-Policy and Permissions-Policy
# are set by the app (next.config.ts); only HSTS lives here.

ekz.mewes-im-netz.de {
	encode zstd gzip

	handle {
		# Next.js streaming — avoid buffering
		reverse_proxy yasl:3000 {
			flush_interval -1
		}
	}

	header {
		# No `preload`: it only applies to apex domains.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
