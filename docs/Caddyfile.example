# Snippet for the host reverse-proxy stack (network `proxy`).
# Production host: see Caddyfile.ekz.mewes-im-netz.de
#
# CSP and other security headers are set by the app (next.config.ts);
# only HSTS lives here.

{$YASL_HOST:ekz.mewes-im-netz.de} {
	encode zstd gzip

	handle {
		reverse_proxy {$YASL_UPSTREAM:yasl:3000} {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
}
